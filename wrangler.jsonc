// Cloudflare Workers config: Motif is a static site, served from public/ (built by `npm run build`).
// Deploy with `npm run deploy`, or connect the GitHub repo in the Cloudflare dashboard (see docs/DEPLOYING.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "motif",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
